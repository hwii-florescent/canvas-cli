    r"^/courses/(?P<course_id>\d+)(?:/|$)"
)
_FILE_PATH_RE = re.compile(
    r"^(?:/[^/]+)*/files/(?P<file_id>\d+)"
    r"(?P<suffix>/(?:download|preview))?/?$"
)


