#!/usr/bin/env python3
"""
canvas.py — headless UF Canvas course resource reader

What it does:
- Reuses a persistent Chromium session for https://ufl.instructure.com
- Automates UF primary login with a local username and macOS Keychain password
- Requests one Duo Push for the user to approve in Duo Mobile when required
- Uses Canvas's read-only APIs and authenticated browser pages for reads
- Lists course navigation sections and their clickable Canvas URLs
- Reads assignments, quizzes, pages, files, and other course sections
- Can download Canvas files without modifying Canvas
- Can submit local files to online-upload assignments after confirmation

Install:
    python3 -m pip install playwright
    python3 -m playwright install chromium

Usage:
    python3 canvas.py
    python3 canvas.py auth setup
    python3 canvas.py student off
    python3 canvas.py student on
    python3 canvas.py student status
    python3 canvas.py fetch https://ufl.instructure.com/courses/1/quizzes/2
    python3 canvas.py fetch https://ufl.instructure.com/courses/1/quizzes/2 --download-dir ./files
    python3 canvas.py course 1
    python3 canvas.py fetch https://ufl.instructure.com/courses/1/pages/setup
    python3 canvas.py fetch https://ufl.instructure.com/courses/1/files --download-dir ./files
    python3 canvas.py fetch https://ufl.instructure.com/courses/1/announcements
    python3 canvas.py submit https://ufl.instructure.com/courses/1/assignments/2 --file ./report.pdf
    python3 canvas.py --course NUR3145
    python3 canvas.py --course
    python3 canvas.py --list-courses --json
    python3 canvas.py --status all --shorten --json
    python3 canvas.py --days 7
    python3 canvas.py --days all     # all future assignments and assignments without due dates
"""

