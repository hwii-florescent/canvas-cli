class _TerminalLoadingBar:
    _FRAMES = (
        "[>         ]",
        "[=>        ]",
        "[==>       ]",
        "[===>      ]",
        "[ ===>     ]",
        "[  ===>    ]",
        "[   ===>   ]",
        "[    ===>  ]",
        "[     ===> ]",
        "[      ===>]",
    )

    def __init__(self, stream, label: str):
        self._stream = stream
        self._label = label
        try:
            self._is_tty = stream.isatty()
        except Exception:
            self._is_tty = False
        self._lock = threading.Lock()
        self._stop_event = threading.Event()
        self._thread = None
        self._frame = 0
        self._running = False
        self._stopped = False

    def __enter__(self):
        self.start()
        return self

    def __exit__(self, exc_type, exc_value, traceback):
        message = (
            f"{self._label} failed."
            if exc_type is not None
            else f"{self._label} ready."
        )
        self.stop(message)

    def start(self) -> None:
        if self._running:
            return
        self._running = True
        with self._lock:
            if self._is_tty:
                self._render_locked()
            else:
                self._stream.write(f"{self._label} {self._FRAMES[0]}\n")
            self._stream.flush()
        if self._is_tty:
            self._thread = threading.Thread(
                target=self._animate,
                name="canvas-loading-bar",
                daemon=True,
            )
            self._thread.start()

    def _render_locked(self) -> None:
        frame = self._FRAMES[self._frame % len(self._FRAMES)]
        self._frame += 1
        self._stream.write(f"\r\x1b[2K{self._label} {frame}")

    def _animate(self) -> None:
        while not self._stop_event.wait(0.12):
            with self._lock:
                if not self._running:
                    return
                self._render_locked()
                self._stream.flush()

    def message(self, message: str) -> None:
        with self._lock:
            if self._is_tty:
                self._stream.write("\r\x1b[2K")
            self._stream.write(f"{message}\n")
            if self._running and self._is_tty:
                self._render_locked()
            self._stream.flush()

    def stop(self, message: str) -> None:
        if not self._running and self._stopped:
            return
        self._running = False
        self._stop_event.set()
        if self._thread is not None and self._thread is not threading.current_thread():
            self._thread.join()
        with self._lock:
            if self._stopped:
                return
            if self._is_tty:
                self._stream.write("\r\x1b[2K")
            self._stream.write(f"{message}\n")
            self._stream.flush()
            self._stopped = True


@contextlib.contextmanager
def _loading_bar(stream, label: str, success_message: str):
    progress = _TerminalLoadingBar(stream, label)
    progress.start()
    try:
        yield progress
    except BaseException:
        progress.stop(f"{label} failed.")
        raise
    else:
        progress.stop(success_message)


def _credentials_error() -> AuthError:
    return AuthError(CREDENTIALS_ERROR)


def _config_dir() -> Path:
    root = Path(
        os.environ.get("XDG_CONFIG_HOME")
        or (Path.home() / ".config")
    )
    directory = root / CONFIG_DIR_NAME
    try:
        if directory.is_symlink():
            raise _credentials_error()
        if directory.exists():
            if not stat.S_ISDIR(directory.stat().st_mode):
                raise _credentials_error()
        else:
            directory.mkdir(parents=True, mode=0o700)
        directory.chmod(0o700)
    except AuthError:
        raise
    except OSError as exc:
        raise _credentials_error() from exc
    return directory


def _config_path() -> Path:
    return _config_dir() / "config.json"


def _validated_username(value: str) -> str:
    username = value.strip()
    if not username or any(character.isspace() for character in username):
        raise _credentials_error()
    return username


def _validated_student_mode(value) -> str:
    if value is None:
        return STUDENT_MODE_ON
    if not isinstance(value, str) or value not in STUDENT_MODES:
        raise _credentials_error()
    return value


def _read_config(*, missing_ok: bool = False) -> dict:
    path = _config_path()
    try:
        if path.is_symlink():
            raise _credentials_error()
        if not path.exists():
            if missing_ok:
                return {}
            raise _credentials_error()
        if not stat.S_ISREG(path.stat().st_mode):
            raise _credentials_error()
        with path.open("r", encoding="utf-8") as handle:
            config = json.load(handle)
    except AuthError:
        raise
    except (OSError, ValueError, TypeError) as exc:
        raise _credentials_error() from exc

    if not isinstance(config, dict):
        raise _credentials_error()
    allowed_keys = {"username", STUDENT_MODE_KEY}
    if set(config) - allowed_keys:
        raise _credentials_error()
    if "username" in config:
        if not isinstance(config["username"], str):
            raise _credentials_error()
        _validated_username(config["username"])
    _validated_student_mode(config.get(STUDENT_MODE_KEY))
    return config


def _write_config(config: dict) -> None:
    path = _config_path()
    try:
        if path.is_symlink():
            raise _credentials_error()
        if path.exists() and not stat.S_ISREG(path.stat().st_mode):
            raise _credentials_error()
    except AuthError:
        raise
    except OSError as exc:
        raise _credentials_error() from exc

    temporary_path: Path | None = None
    try:
        descriptor, temporary_name = tempfile.mkstemp(
            prefix=".config.",
            dir=str(path.parent),
        )
        temporary_path = Path(temporary_name)
        os.fchmod(descriptor, 0o600)
        with os.fdopen(descriptor, "w", encoding="utf-8") as handle:
            json.dump(config, handle, separators=(",", ":"))
            handle.write("\n")
            handle.flush()
            os.fsync(handle.fileno())
        os.replace(temporary_path, path)
        temporary_path = None
        path.chmod(0o600)
    except AuthError:
        raise
    except OSError as exc:
        raise _credentials_error() from exc
    finally:
        if temporary_path is not None:
            try:
                temporary_path.unlink()
            except FileNotFoundError:
                pass


def _write_username_config(
    username: str,
    *,
    student_mode: str = STUDENT_MODE_ON,
) -> None:
    student_mode = _validated_student_mode(student_mode)
    config = {"username": username}
    if student_mode != STUDENT_MODE_ON:
        config[STUDENT_MODE_KEY] = student_mode
    _write_config(config)


def load_student_mode() -> str:
    config = _read_config(missing_ok=True)
    return _validated_student_mode(config.get(STUDENT_MODE_KEY))


def set_student_mode(mode: str) -> str:
    mode = _validated_student_mode(mode)
    config = _read_config(missing_ok=True)
    updated = {}
    if "username" in config:
        updated["username"] = config["username"]
    updated[STUDENT_MODE_KEY] = mode
    _write_config(updated)
    return mode


def student_mode_command(action: str) -> int:
    if action == "status":
        print(f"Student mode: {load_student_mode()}")
        return 0
    if action not in STUDENT_MODES:
        raise ValueError(f"unknown student mode command: {action}")
    mode = set_student_mode(action)
    print(f"Student mode set to {mode}.")
    return 0


def _store_keychain_password(username: str) -> None:
    command = [
        "/usr/bin/security",
        "add-generic-password",
        "-U",
        "-a",
        username,
        "-s",
        KEYCHAIN_SERVICE,
        "-l",
        KEYCHAIN_LABEL,
        "-w",
    ]
    try:
        result = subprocess.run(command, check=False)
    except OSError as exc:
        raise _credentials_error() from exc
    if result.returncode != 0:
        raise _credentials_error()


def _read_keychain_password(username: str) -> str:
    command = [
        "/usr/bin/security",
        "find-generic-password",
        "-a",
        username,
        "-s",
        KEYCHAIN_SERVICE,
        "-w",
    ]
    try:
        result = subprocess.run(
            command,
            check=False,
            capture_output=True,
            text=True,
        )
    except OSError as exc:
        raise _credentials_error() from exc
    if result.returncode != 0 or not isinstance(result.stdout, str):
        raise _credentials_error()
    password = (
        result.stdout[:-1]
        if result.stdout.endswith("\n")
        else result.stdout
    )
    if not password:
        raise _credentials_error()
    return password


def configure_auth() -> int:
    try:
        student_mode = load_student_mode()
        username = _validated_username(input("GatorLink username: "))
        _store_keychain_password(username)
        _read_keychain_password(username)
        _write_username_config(username, student_mode=student_mode)
    except AuthError:
        raise
    except (EOFError, KeyboardInterrupt) as exc:
        raise _credentials_error() from exc

    print("Canvas credentials configured.", file=sys.stderr)
    return 0


def load_credentials() -> Credentials:
    config = _read_config()
    if "username" not in config:
        raise _credentials_error()

    username = _validated_username(config["username"])
    return Credentials(username, _read_keychain_password(username))


class _HTMLToText(HTMLParser):
    BLOCK_TAGS = {
        "p", "div", "section", "article", "header", "footer",
        "h1", "h2", "h3", "h4", "h5", "h6",
        "ul", "ol", "li", "table", "tr", "blockquote", "pre",
    }

    def __init__(self):
        super().__init__(convert_charrefs=True)
        self.parts: list[str] = []

    def handle_starttag(self, tag, attrs):
        tag = tag.lower()
        if tag == "br":
            self.parts.append("\n")
        elif tag == "li":
            self.parts.append("\n• ")
        elif tag in self.BLOCK_TAGS:
            self.parts.append("\n")

    def handle_endtag(self, tag):
        if tag.lower() in self.BLOCK_TAGS:
            self.parts.append("\n")

    def handle_data(self, data):
        self.parts.append(data)

    def text(self) -> str:
        text = html.unescape("".join(self.parts))
        text = re.sub(r"[ \t]+", " ", text)
        text = re.sub(r" *\n *", "\n", text)
        text = re.sub(r"\n{3,}", "\n\n", text)
        return text.strip()


def html_to_text(value: str | None) -> str:
    if not value:
        return ""
    parser = _HTMLToText()
    try:
        parser.feed(value)
        return parser.text()
    except Exception:
        return re.sub(r"<[^>]+>", "", html.unescape(value)).strip()


class _AttachmentParser(HTMLParser):
    def __init__(self):
        super().__init__(convert_charrefs=True)
        self.attachments: list[dict] = []
        self._anchor: dict | None = None

    def _finish_anchor(self) -> None:
        if self._anchor is not None:
            self.attachments.append(self._anchor)
            self._anchor = None

    def handle_starttag(self, tag, attrs):
        tag = tag.lower()
        if tag == "a":
            if self._anchor is not None:
                return
            attributes = dict(attrs)
            href = attributes.get("href")
            if not href:
                return
            label = (
                attributes.get("download")
                or attributes.get("data-file-name")
                or attributes.get("title")
                or attributes.get("aria-label")
                or ""
            )
            self._anchor = {
                "href": href,
                "label": label,
                "parts": [],
            }
        elif self._anchor is not None and tag in {"img", "input"}:
            attributes = dict(attrs)
            alt = attributes.get("alt")
            if alt:
                self._anchor["parts"].append(alt)

    def handle_data(self, data):
        if self._anchor is not None:
            self._anchor["parts"].append(data)

    def handle_endtag(self, tag):
        if tag.lower() == "a":
            self._finish_anchor()

    def close(self):
        super().close()
        self._finish_anchor()


def _canvas_file_download_url(href: str | None) -> tuple[int, str] | None:
    if not href or not isinstance(href, str):
        return None

    absolute = urljoin(BASE_URL + "/", href.strip())
    parsed = urlsplit(absolute)
    if (
        parsed.scheme != "https"
        or (parsed.hostname or "").casefold() != CANVAS_HOST.casefold()
        or parsed.path.startswith("/api/")
    ):
        return None

    match = _FILE_PATH_RE.match(parsed.path)
    if not match:
        return None

    path = parsed.path.rstrip("/")
    if path.endswith("/preview"):
        path = path[:-len("/preview")]
    if not path.endswith("/download"):
        path += "/download"
    return (
        int(match.group("file_id")),
        urlunsplit((parsed.scheme, parsed.netloc, path, parsed.query, "")),
    )


def _normalize_attachment_label(value: str | None) -> str:
    return re.sub(r"\s+", " ", html.unescape(value or "")).strip()


def extract_attachments(value: str | None) -> list[dict]:
    if not value:
        return []

    parser = _AttachmentParser()
    try:
        parser.feed(value)
        parser.close()
    except Exception:
        return []

    attachments = []
    seen = set()
    for candidate in parser.attachments:
        resolved = _canvas_file_download_url(candidate.get("href"))
        if resolved is None:
            continue
        file_id, download_url = resolved
        key = (file_id, download_url)
        if key in seen:
            continue
        seen.add(key)

        label = _normalize_attachment_label(
            "".join(candidate.get("parts") or [])
        )
        if not label:
            label = _normalize_attachment_label(candidate.get("label"))
        if not label:
            label = f"file-{file_id}"
        attachments.append(
            {
                "name": label,
                "file_id": file_id,
                "url": download_url,
            }
        )
    return attachments


def validate_canvas_course_url(value: str) -> str:
    if not isinstance(value, str):
        raise ValueError(
            "Canvas URL must be an https://ufl.instructure.com/courses/ URL."
        )
    target_url = value.strip()
    parsed = urlsplit(target_url)
    if (
        parsed.scheme != "https"
        or (parsed.hostname or "").casefold() != CANVAS_HOST.casefold()
    ):
        raise ValueError(
            "Canvas URL must use https://ufl.instructure.com."
        )
    if not _COURSE_PATH_RE.match(parsed.path):
        raise ValueError(
            "Canvas URL must identify a Canvas course path under "
            "https://ufl.instructure.com/courses/."
        )
    return target_url


def _parse_canvas_resource_url(value: str) -> tuple[str, int, str | int | None]:
    if not isinstance(value, str):
        raise ValueError(
            "Canvas URL must look like "
            "https://ufl.instructure.com/courses/COURSE_ID/"
            "assignments|quizzes/ID, pages[/PAGE_URL], or files[/FILE_ID]"
        )

    parsed = urlsplit(value.strip())
    if (
        parsed.scheme != "https"
        or (parsed.hostname or "").casefold() != CANVAS_HOST.casefold()
    ):
        raise ValueError(
            "Canvas URL must use https://ufl.instructure.com."
        )

    match = _TARGET_PATH_RE.match(parsed.path)
    if match:
        return (
            match.group("resource_type"),
            int(match.group("course_id")),
            int(match.group("resource_id")),
        )

    match = _PAGE_PATH_RE.match(parsed.path)
    if match:
        page_url = match.group("page_url")
        return (
            "pages",
            int(match.group("course_id")),
            unquote(page_url) if page_url else None,
        )

    match = _COURSE_FILES_PATH_RE.match(parsed.path)
    if match:
        return "files", int(match.group("course_id")), None

    match = _COURSE_FILE_PATH_RE.match(parsed.path)
    if match:
        return (
            "files",
            int(match.group("course_id")),
            int(match.group("file_id")),
        )

    raise ValueError(
        "Canvas URL must look like "
        "https://ufl.instructure.com/courses/COURSE_ID/"
        "assignments|quizzes/ID, pages[/PAGE_URL], or files[/FILE_ID]"
    )


def parse_canvas_resource_url(
    value: str,
) -> tuple[str, int, str | int | None]:
    return _parse_canvas_resource_url(value)


def parse_canvas_target_url(value: str) -> tuple[str, int, int]:
    resource_type, course_id, resource_id = _parse_canvas_resource_url(value)
    if resource_type not in {"assignments", "quizzes"}:
        raise ValueError(
            "Canvas URL must look like "
            "https://ufl.instructure.com/courses/COURSE_ID/"
            "assignments|quizzes/ID"
        )
    return resource_type, course_id, int(resource_id)


def parse_canvas_datetime(value: str | None) -> datetime | None:
    if not value:
        return None
    try:
        return datetime.fromisoformat(value.replace("Z", "+00:00"))
    except ValueError:
        return None


def _api_response(page, path: str, params: list[tuple[str, str]] | None = None):
    url = BASE_URL + path
    if params:
        url += "?" + urlencode(params)

    result = page.evaluate(
        """async (url) => {
            const controller = new AbortController();
            const timeout = setTimeout(() => controller.abort(), 15000);
            try {
                const response = await fetch(url, {
                    method: "GET",
                    credentials: "include",
                    headers: {"Accept": "application/json"},
                    signal: controller.signal
                });
                return {
                    ok: response.ok,
                    status: response.status,
                    text: await response.text()
                };
            } catch (e) {
                return {
                    ok: false,
                    status: 0,
                    text: e.name === "AbortError"
                        ? "Canvas API request timed out"
                        : String(e)
                };
            } finally {
                clearTimeout(timeout);
            }
        }""",
        url,
    )
    if not isinstance(result, dict):
        raise RuntimeError("Canvas API returned an invalid response.")
    return result


def api_get(page, path: str, params: list[tuple[str, str]] | None = None):
    result = _api_response(page, path, params)

    if not result.get("ok"):
        text = str(result.get("text") or "")
        raise RuntimeError(
            f"Canvas API request failed ({result.get('status', 0)}): {path}\n"
            f"{text[:500]}"
        )

    try:
        return json.loads(result["text"])
    except (KeyError, TypeError, json.JSONDecodeError) as exc:
        raise RuntimeError(
            f"Canvas returned a non-JSON response for {path}. "
            "Your login session may have expired."
        ) from exc




def _request_client(page):
    request = getattr(getattr(page, "context", None), "request", None)
    if request is None:
        raise RuntimeError("the authenticated browser context has no request client")
    return request


def _csrf_headers(page) -> dict[str, str]:
    context = getattr(page, "context", None)
    try:
        cookies = context.cookies() if context is not None else []
    except Exception:
        return {}
    if not isinstance(cookies, list):
        return {}

    canvas_host = CANVAS_HOST.casefold()
    for cookie in cookies:
        if not isinstance(cookie, dict) or cookie.get("name") != "_csrf_token":
            continue
        domain = str(cookie.get("domain") or "").lstrip(".").casefold()
        if domain and not (
            canvas_host == domain or canvas_host.endswith(f".{domain}")
        ):
            continue
        value = cookie.get("value")
        if isinstance(value, str) and value:
            return {"X-CSRF-Token": unquote(value)}
    return {}


def _response_text(response) -> str:
    try:
        return str(response.text() or "")
    except Exception:
        return ""


def _response_json(response, path: str):
    text = _response_text(response)
    if not response.ok:
        raise RuntimeError(
            f"Canvas API request failed ({response.status}): {path}\n"
            f"{text[:500]}"
        )
    try:
        return json.loads(text)
    except json.JSONDecodeError as exc:
        raise RuntimeError(
            f"Canvas returned a non-JSON response for {path}."
        ) from exc


def api_post(page, path: str, *, form=None, multipart=None):
    if (form is None) == (multipart is None):
        raise ValueError("provide exactly one POST body")
    request = _request_client(page)
    options = {
        "headers": {"Accept": "application/json", **_csrf_headers(page)},
        "timeout": 60_000,
    }
    if form is not None:
        options["form"] = form
    else:
        options["multipart"] = multipart
    response = request.post(BASE_URL + path, **options)
    return _response_json(response, path)


def paginated_get(page, path: str, params: list[tuple[str, str]] | None = None):
    params = list(params or [])
    out = []
    page_number = 1

    while True:
        current = params + [
            ("per_page", "100"),
            ("page", str(page_number)),
        ]
        data = api_get(page, path, current)

        if not isinstance(data, list):
            raise RuntimeError(f"Unexpected Canvas response for {path}")

        out.extend(data)

        if len(data) < 100:
            return out

        page_number += 1


def _safe_attachment_filename(name: str | None, file_id: int) -> str:
    filename = _normalize_attachment_label(name)
    filename = unquote(filename)
    filename = re.sub(r"[\x00-\x1f\x7f]", "_", filename)
    filename = filename.replace("/", "_").replace("\\", "_").strip()
    if not filename or filename in {".", ".."}:
        return f"file-{file_id}"
    return filename


def _available_download_path(directory: Path, filename: str) -> Path:
    candidate = directory / filename
    if not candidate.exists() and not candidate.is_symlink():
        return candidate

    stem = candidate.stem
    suffix = candidate.suffix
    counter = 2
    while True:
        candidate = directory / f"{stem} ({counter}){suffix}"
        if not candidate.exists() and not candidate.is_symlink():
            return candidate
        counter += 1


def download_attachment(
    page,
    attachment: dict,
    directory: str | Path,
) -> Path:
    resolved = _canvas_file_download_url(attachment.get("url"))
    if resolved is None:
        raise RuntimeError("attachment URL is not a UF Canvas file URL")
    _, download_url = resolved

    download_directory = Path(directory).expanduser()
    download_directory.mkdir(parents=True, exist_ok=True)
    file_id = int(attachment.get("file_id") or resolved[0])
    filename = _safe_attachment_filename(attachment.get("name"), file_id)
    destination = _available_download_path(download_directory, filename)

    request = _request_client(page)

    response = request.get(download_url, timeout=60_000)
    if not response.ok:
        raise RuntimeError(
            f"Canvas file request failed ({response.status}): {download_url}"
        )
    body = response.body()
    if not isinstance(body, (bytes, bytearray)):
        raise RuntimeError("Canvas returned an invalid file response")

    temporary_name = None
    try:
        with tempfile.NamedTemporaryFile(
            mode="wb",
            prefix=".canvas-download-",
            dir=str(download_directory),
            delete=False,
        ) as temporary:
            temporary_name = temporary.name
            temporary.write(body)
        os.replace(temporary_name, destination)
        temporary_name = None
    finally:
        if temporary_name is not None:
            try:
                os.unlink(temporary_name)
            except OSError:
                pass
    return destination


def download_attachments(page, rows: list[dict], directory, progress=None):
    for row in rows:
        for attachment in row.get("attachments") or []:
            name = attachment.get("name") or "unnamed file"
            try:
                destination = download_attachment(page, attachment, directory)
            except Exception as exc:
                raise RuntimeError(
                    f"Unable to download Canvas attachment {name!r}: {exc}"
                ) from exc
            attachment["local_path"] = str(destination)
            if progress is not None:
                progress.message(f"Downloaded {name!r} to {destination}")
    return rows

def download_files(page, rows: list[dict], directory, progress=None):
    for row in rows:
        name = row.get("name") or row.get("title") or "unnamed file"
        attachment = {
            "name": name,
            "file_id": row.get("id"),
            "url": row.get("url"),
        }
        try:
            destination = download_attachment(page, attachment, directory)
        except Exception as exc:
            raise RuntimeError(
                f"Unable to download Canvas file {name!r}: {exc}"
            ) from exc
        row["local_path"] = str(destination)
        if progress is not None:
            progress.message(f"Downloaded {name!r} to {destination}")
    return rows


def is_logged_in(page) -> bool:
    result = _api_response(page, "/api/v1/users/self/profile")
    if result.get("status") == 401:
        return False
    if not result.get("ok"):
        text = str(result.get("text") or "")
        raise RuntimeError(
            "Canvas session check failed "
            f"({result.get('status', 0)}): {text[:500]}"
        )

    try:
        profile = json.loads(result["text"])
    except (KeyError, TypeError, json.JSONDecodeError) as exc:
        raise RuntimeError("Canvas returned an invalid profile response.") from exc

    if not isinstance(profile, dict) or not profile.get("id"):
        raise RuntimeError("Canvas returned an invalid profile response.")
    return True


def launch_context(playwright):
    return playwright.chromium.launch_persistent_context(
        user_data_dir=str(PROFILE_DIR),
        headless=True,
        viewport={"width": 1280, "height": 900},
    )


def _auth_surfaces(page):
    surfaces = [page]
    try:
        surfaces.extend(page.frames)
    except Exception:
        pass

    seen = set()
    for surface in surfaces:
        identity = id(surface)
        if identity not in seen:
            seen.add(identity)
            yield surface


def _first_visible(surface, locators):
    for locator in locators:
        try:
            count = locator.count()
            for index in range(count):
                candidate = locator.nth(index)
                if candidate.is_visible():
                    return candidate
        except Exception:
            continue
    return None


def _primary_form_controls(page):
    username = _first_visible(
        page,
        [
            page.get_by_label("Username", exact=True),
            page.locator('input[autocomplete="username"]'),
            page.locator('input[name="j_username"]'),
            page.locator('input[name="username"]'),
        ],
    )
    password = _first_visible(
        page,
        [
            page.get_by_label("Password", exact=True),
            page.locator('input[autocomplete="current-password"]'),
            page.locator('input[name="j_password"]'),
            page.locator('input[type="password"]'),
        ],
    )
    submit = _first_visible(
        page,
        [
            page.locator('button[type="submit"]'),
            page.locator('input[type="submit"]'),
        ],
    )
    return username, password, submit


def fill_primary_credentials(page, credentials: Credentials) -> None:
    deadline = time.monotonic() + PRIMARY_FORM_WAIT_SECONDS
    saw_loading = _page_has_text(page, LOGIN_LOADING)
    while True:
        username, password, submit = _primary_form_controls(page)
        if username is not None and password is not None and submit is not None:
            break
        if time.monotonic() >= deadline:
            raise RuntimeError("UF login form was not recognized.")
        if not saw_loading:
            saw_loading = _page_has_text(page, LOGIN_LOADING)
            if not saw_loading:
                raise RuntimeError("UF login form was not recognized.")
        try:
            page.wait_for_timeout(100)
        except Exception:
            time.sleep(0.1)

    username.fill(credentials.username)
    password.fill(credentials.password)
    submit.click()


PRIMARY_AUTH_FAILURE = re.compile(
    r"invalid (?:username|user name|credentials?)"
    r"|incorrect (?:username|user name|password|credentials?)"
    r"|authentication failed"
    r"|login failed"
    r"|credentials? (?:are )?invalid",
    re.IGNORECASE,
)
DUO_PUSH_SENT = re.compile(
    r"check for a duo push"
    r"|a login request was sent to your device"
    r"|we['’]ve sent a notification",
    re.IGNORECASE,
)
DUO_PUSH_CONTROL = re.compile(
    r"send me a push"
    r"|send a push"
    r"|duo push"
    r"|verify with duo push",
    re.IGNORECASE,
)
DUO_VERIFICATION_CODE = re.compile(r"\b\d{3}\b")
DUO_CODE_CONTEXT = re.compile(r"\b(?:code|number|verification)\b", re.IGNORECASE)
OTHER_OPTIONS_CONTROL = re.compile(r"other options", re.IGNORECASE)
LOGIN_LOADING = re.compile(
    r"loading (?:login )?session information|automatically redirected",
    re.IGNORECASE,
)


def _surface_text(surface) -> str:
    try:
        return surface.locator("body").inner_text(timeout=1000)
    except Exception:
        return ""


def _page_has_text(page, pattern: re.Pattern[str]) -> bool:
    return any(pattern.search(_surface_text(surface)) for surface in _auth_surfaces(page))


def _control_label(control) -> str:
    values = []
    try:
        values.append(control.inner_text())
    except Exception:
        pass
    for attribute in ("value", "aria-label", "title"):
        try:
            value = control.get_attribute(attribute)
        except Exception:
            value = None
        if value:
            values.append(value)
    return " ".join(values)


def _find_control(page, pattern: re.Pattern[str]):
    for surface in _auth_surfaces(page):
        try:
            role_control = _first_visible(
                surface,
                [surface.get_by_role("button", name=pattern)],
            )
        except Exception:
            role_control = None
        if role_control is not None:
            return role_control

        for selector in (
            "button",
            'input[type="button"]',
            'input[type="submit"]',
            "a",
        ):
            try:
                controls = surface.locator(selector)
                for index in range(controls.count()):
                    control = controls.nth(index)
                    if control.is_visible() and pattern.search(_control_label(control)):
                        return control
            except Exception:
                continue
    return None


def request_duo_push(page) -> bool:
    if _page_has_text(page, DUO_PUSH_SENT):
        return True

    direct_control = _find_control(page, DUO_PUSH_CONTROL)
    if direct_control is not None:
        direct_control.click()
        return True

    other_options = _find_control(page, OTHER_OPTIONS_CONTROL)
    if other_options is None:
        return False

    other_options.click()
    deadline = time.monotonic() + DUO_OPTION_WAIT_SECONDS
    while True:
        duo_control = _find_control(page, DUO_PUSH_CONTROL)
        if duo_control is not None:
            duo_control.click()
            return True
        if time.monotonic() >= deadline:
            return False
        try:
            page.wait_for_timeout(100)
        except Exception:
            time.sleep(0.1)


def _duo_prompt_visible(page) -> bool:
    return (
        _page_has_text(page, DUO_PUSH_SENT)
        or _find_control(page, DUO_PUSH_CONTROL) is not None
        or _find_control(page, OTHER_OPTIONS_CONTROL) is not None
    )


def _duo_verification_code(page) -> str | None:
    for surface in _auth_surfaces(page):
        text = _surface_text(surface)
        if not text:
            continue
        for match in DUO_VERIFICATION_CODE.finditer(text):
            context_start = max(0, match.start() - 120)
            context_end = min(len(text), match.end() + 80)
            if DUO_CODE_CONTEXT.search(text[context_start:context_end]):
                return match.group()
    return None


def _auth_message(message: str, progress=None) -> None:
    if progress is None:
        print(message, file=sys.stderr, flush=True)
    else:
        progress.message(message)


def _wait_for_duo_approval(page, progress=None) -> bool:
    deadline = time.monotonic() + DUO_TIMEOUT_SECONDS
    displayed_code = None
    while time.monotonic() < deadline:
        if page.is_closed():
            raise RuntimeError("Duo approval was not completed within 180 seconds.")
        code = _duo_verification_code(page)
        if code and code != displayed_code:
            _auth_message(
                f"Duo verification code: {code}; enter it in Duo Mobile.",
                progress,
            )
            displayed_code = code
        if page.url.startswith(BASE_URL) and is_logged_in(page):
            return True
        time.sleep(1)

    raise RuntimeError("Duo approval was not completed within 180 seconds.")


def ensure_login(page, progress=None) -> bool:
    response = page.goto(PROFILE_URL, wait_until="commit", timeout=60_000)
    if response is not None and response.status == 200:
        try:
            profile = json.loads(response.text())
            if isinstance(profile, dict) and profile.get("id"):
                return True
        except Exception:
            pass
    if response is None or response.status != 401:
        if is_logged_in(page):
            return True
    credentials = load_credentials()
    page.goto(LOGIN_URL, wait_until="domcontentloaded", timeout=60_000)
    fill_primary_credentials(page, credentials)

    post_primary_deadline = time.monotonic() + 15
    push_checked = False
    while time.monotonic() < post_primary_deadline:
        if page.is_closed():
            raise RuntimeError("UF login ended before Canvas authentication completed.")
        if _page_has_text(page, PRIMARY_AUTH_FAILURE):
            raise RuntimeError(
                "UF rejected the stored credentials. Run: canvas auth setup"
            )
        if page.url.startswith(BASE_URL) and is_logged_in(page):
            return True
        if not push_checked and _duo_prompt_visible(page):
            push_checked = True
            if not request_duo_push(page):
                raise RuntimeError("Duo Push is not available for this account.")
            _auth_message("Duo Push sent; approve it in Duo Mobile.", progress)
            _wait_for_duo_approval(page, progress=progress)
            _auth_message("Duo verification succeeded.", progress)
            return True
        time.sleep(0.25)

    if _page_has_text(page, PRIMARY_AUTH_FAILURE):
        raise RuntimeError(
            "UF rejected the stored credentials. Run: canvas auth setup"
        )
    if page.url.startswith(BASE_URL) and is_logged_in(page):
        return True
    if not push_checked:
        push_checked = True
        if request_duo_push(page):
            _auth_message("Duo Push sent; approve it in Duo Mobile.", progress)
            _wait_for_duo_approval(page, progress=progress)
            _auth_message("Duo verification succeeded.", progress)
            return True
    raise RuntimeError("Duo Push is not available for this account.")


def submission_status(assignment: dict) -> str:
    submission = assignment.get("submission") or {}

    if submission.get("missing"):
        return "missing"
    if submission.get("late"):
        return "late"
    if submission.get("workflow_state") == "graded":
        return "graded"
    if submission.get("submitted_at"):
        return "submitted"

    return "unsubmitted"




def fetch_courses(page, *, student_only: bool = True):
    params = [("enrollment_state", "active")]
    if student_only:
        params.append(("enrollment_type", "student"))
    params.append(("include[]", "term"))
    return paginated_get(page, "/api/v1/courses", params)


def normalize_course_filters(values: list[str] | None) -> set[str]:
    filters = set()
    for value in values or []:
        normalized = value.strip().casefold()
        if not normalized:
            raise ValueError("--course requires a non-empty value")
        filters.add(normalized)
    return filters


def course_matches(course: dict, filters: set[str]) -> bool:
    if not filters:
        return True
    return any(
        isinstance(value, str) and value.strip().casefold() in filters
        for value in (course.get("course_code"), course.get("name"))
    )

def normalize_days(value: str | int | None) -> int:
    if value is None:
        return 14
    if isinstance(value, str):
        normalized = value.strip().casefold()
        if normalized == "all":
            return 0
        try:
            days = int(normalized)
        except ValueError:
            raise ValueError("--days must be a non-negative integer or 'all'")
    else:
        days = int(value)
    if days < 0:
        raise ValueError("--days must be a non-negative integer or 'all'")
    return days


def filter_courses(courses: list[dict], filters: set[str]) -> list[dict]:
    return [course for course in courses if course_matches(course, filters)]


STATUS_FILTERS = ("unsubmitted", "submitted", "graded", "all")

def normalize_status_filter(value: str) -> str:
    normalized = value.strip().casefold()
    if normalized not in STATUS_FILTERS:
        allowed = ", ".join(STATUS_FILTERS)
        raise ValueError(f"--status must be one of: {allowed}")
    return normalized


def status_matches(status: str, status_filter: str) -> bool:
    if status_filter == "all":
        return True
    return status == status_filter


def course_label(course: dict) -> str:
    course_code = str(course.get("course_code") or "").strip()
    name = str(course.get("name") or "").strip()
    if course_code and name and course_code.casefold() != name.casefold():
        return f"{course_code} — {name}"
    return course_code or name or f"Course {course.get('id', 'unknown')}"


def course_summary(course: dict) -> dict:
    return {
        "id": course.get("id"),
        "course_code": course.get("course_code"),
        "name": course.get("name"),
    }


def _ordered_courses(courses: list[dict]) -> list[dict]:
    return sorted(courses, key=lambda item: course_label(item).casefold())


def print_courses(courses: list[dict]) -> None:
    if not courses:
        print("No active courses found.")
        return

    for index, course in enumerate(_ordered_courses(courses), 1):
        print(f"{index}. {course_label(course)}")


def parse_course_id(value: str) -> int:
    if not isinstance(value, str) or not value.strip().isdigit():
        raise ValueError("course ID must be a positive integer")
    course_id = int(value.strip())
    if course_id <= 0:
        raise ValueError("course ID must be a positive integer")
    return course_id


def _canvas_link_url(value) -> str:
    if not isinstance(value, str) or not value.strip():
        return ""
    return urljoin(BASE_URL + "/", value.strip())


def fetch_course_navigation(
    page,
    course_id: int,
    courses: list[dict] | None = None,
) -> dict:
    tabs = paginated_get(page, f"/api/v1/courses/{course_id}/tabs")
    if not isinstance(tabs, list):
        raise RuntimeError("Canvas returned an invalid course navigation response")
    if any(not isinstance(tab, dict) for tab in tabs):
        raise RuntimeError("Canvas returned an invalid course navigation item")

    courses = fetch_courses(page) if courses is None else courses
    course = _course_for_id(courses, course_id)
    sections = []
    for tab in tabs:
        raw_label = tab.get("label") or tab.get("id")
        label = str(raw_label or "Untitled section").strip()
        position = tab.get("position")
        if not isinstance(position, int):
            position = None
        sections.append(
            {
                "id": tab.get("id"),
                "label": label,
                "url": _canvas_link_url(tab.get("html_url")),
                "type": tab.get("type"),
                "position": position,
                "hidden": bool(tab.get("hidden", False)),
                "visibility": tab.get("visibility"),
            }
        )
    sections.sort(
        key=lambda section: (
            section["position"] is None,
            section["position"] if section["position"] is not None else 0,
            section["label"].casefold(),
        )
    )
    course_display = course_label(course) if course else f"Course {course_id}"
    return {
        "course_id": course_id,
        "course": course_display,
        "course_name": course.get("name") or course_display,
        "url": f"{BASE_URL}/courses/{course_id}",
        "sections": sections,
    }


def print_course_navigation(navigation: dict) -> None:
    print(f"Course: {navigation['course']}")
    print(f"URL: {navigation['url']}")
    sections = navigation.get("sections") or []
    if not sections:
        print("No course sections found.")
        return
    print("Sections:")
    for index, section in enumerate(sections, 1):
        hidden = " [hidden]" if section.get("hidden") else ""
        print(f"{index}. {section['label']}{hidden}")
        if section.get("url"):
            print(f"   URL: {section['url']}")
    print()


def _read_terminal_key(stream) -> str:
    descriptor = stream.fileno()
    first = os.read(descriptor, 1)
    if not first:
        return "cancel"
    if first == b"\x1b":
        sequence = b""
        for _ in range(2):
            ready, _, _ = select.select([descriptor], [], [], 0.05)
            if not ready:
                return "cancel"
            sequence += os.read(descriptor, 1)
        return {"[A": "up", "[B": "down"}.get(
            sequence.decode("ascii", errors="ignore"),
            "cancel",
        )
    if first in (b"\r", b"\n"):
        return "confirm"
    if first == b" ":
        return "toggle"
    if first in (b"\x03", b"q", b"Q"):
        return "cancel"
    if first in (b"k", b"K"):
        return "up"
    if first in (b"j", b"J"):
        return "down"
    return "unknown"


@contextlib.contextmanager
def _cbreak_terminal(stream):
    descriptor = stream.fileno()
    attributes = termios.tcgetattr(descriptor)
    try:
        tty.setcbreak(descriptor)
        yield
    finally:
        termios.tcsetattr(descriptor, termios.TCSADRAIN, attributes)


def _terminal_width(stream) -> int:
    try:
        columns = os.get_terminal_size(stream.fileno()).columns
    except (AttributeError, OSError, ValueError):
        return 80
    return columns if columns > 0 else 80


def _terminal_height(stream) -> int:
    try:
        rows = os.get_terminal_size(stream.fileno()).lines
    except (AttributeError, OSError, ValueError):
        return 24
    return rows if rows > 0 else 24


def _picker_visible_count(stream, message: str) -> int:
    reserved_lines = 3 + (2 if message else 0)
    return max(1, _terminal_height(stream) - reserved_lines)


def _picker_window_start(cursor: int, total: int, visible_count: int) -> int:
    return min(
        max(0, cursor - visible_count + 1),
        max(0, total - visible_count),
    )


def _clear_terminal(stream) -> None:
    stream.write("\x1b[2J\x1b[H")


def _terminal_char_width(char: str) -> int:
    if unicodedata.combining(char):
        return 0
    return 2 if unicodedata.east_asian_width(char) in {"W", "F"} else 1


def _terminal_cell_width(text: str) -> int:
    return sum(_terminal_char_width(char) for char in text)


def _take_terminal_cells(text: str, width: int) -> str:
    result = []
    used = 0
    for char in text:
        char_width = _terminal_char_width(char)
        if used + char_width > width:
            break
        result.append(char)
        used += char_width
    return "".join(result)


def _fit_terminal_line(value, width: int) -> str:
    text = "".join(char if char.isprintable() else " " for char in str(value))
    if _terminal_cell_width(text) <= width:
        return text
    if width <= 3:
        return _take_terminal_cells(text, width)
    return _take_terminal_cells(text, width - 3) + "..."


def _render_course_picker(
    courses: list[dict],
    cursor: int,
    selected: set[int],
    stdout,
    message: str = "",
    *,
    start: int | None = None,
    visible_count: int | None = None,
) -> None:
    # Leave one column unused so terminals do not autowrap at the edge.
    width = max(1, _terminal_width(stdout) - 1)
    visible_count = (
        _picker_visible_count(stdout, message)
        if visible_count is None
        else max(1, visible_count)
    )
    start = (
        _picker_window_start(cursor, len(courses), visible_count)
        if start is None
        else max(0, start)
    )
    end = min(len(courses), start + visible_count)
    lines = [
        _fit_terminal_line(
            "Select courses "
            "(Up/Down or j/k move, Space toggle, Enter apply, q cancel)",
            width,
        ),
        _fit_terminal_line(
            f"Selected: {len(selected)} | Showing {start + 1}-{end} of {len(courses)}",
            width,
        ),
    ]
    for index in range(start, end):
        course = courses[index]
        marker = ">" if index == cursor else " "
        checked = "x" if index in selected else " "
        lines.append(
            _fit_terminal_line(
                f"{marker} [{checked}] {course_label(course)}",
                width,
            )
        )
    if message:
        lines.extend(["", _fit_terminal_line(message, width)])
    _clear_terminal(stdout)
    stdout.write("\n".join(lines) + "\n")
    stdout.flush()


def _render_course_loading(stdout, selected_count: int) -> None:
    width = max(1, _terminal_width(stdout) - 1)
    plural = "course" if selected_count == 1 else "courses"
    lines = [
        _fit_terminal_line("Loading Canvas data...", width),
        _fit_terminal_line(
            f"Processing {selected_count} selected {plural}.",
            width,
        ),
    ]
    _clear_terminal(stdout)
    stdout.write("\n".join(lines) + "\n")
    stdout.flush()


def _run_course_picker(courses, read_key, stdout):
    selected: set[int] = set()
    cursor = 0
    message = ""
    while True:
        _render_course_picker(courses, cursor, selected, stdout, message)
        key = read_key()
        if key == "up":
            cursor = (cursor - 1) % len(courses)
            message = ""
        elif key == "down":
            cursor = (cursor + 1) % len(courses)
            message = ""
        elif key == "toggle":
            if cursor in selected:
                selected.remove(cursor)
            else:
                selected.add(cursor)
            message = ""
        elif key == "confirm":
            if not selected:
                message = "Select at least one course before pressing Enter."
                continue
            selected_courses = [
                courses[index] for index in range(len(courses)) if index in selected
            ]
            _render_course_loading(stdout, len(selected_courses))
            return selected_courses
        elif key == "cancel":
            stdout.write("\n")
            stdout.flush()
            raise RuntimeError("Course selection cancelled.")
        else:
            message = "Use Up/Down, Space, Enter, or q."



@contextlib.contextmanager
def _picker_terminal_session(stdin, stdout):
    if not stdin.isatty() or not stdout.isatty():
        raise RuntimeError(
            "Interactive course selection requires a terminal. "
            "Use --course NAME or --list-courses."
        )
    stdout.write("\x1b[?1049h\x1b[?25l")
    stdout.flush()
    try:
        with _cbreak_terminal(stdin):
            try:
                yield
            finally:
                _flush_terminal_input(stdin)
    finally:
        stdout.write("\x1b[?25h\x1b[?1049l")
        stdout.flush()


def _flush_terminal_input(stdin) -> None:
    try:
        termios.tcflush(stdin.fileno(), termios.TCIFLUSH)
    except Exception:
        pass

def _select_ordered_courses(ordered, stdin, stdout):
    if not ordered:
        return []
    selected = _run_course_picker(
        ordered,
        lambda: _read_terminal_key(stdin),
        stdout,
    )
    _flush_terminal_input(stdin)
    return selected

def select_courses(
    courses: list[dict],
    *,
    read_key=None,
    stdin=None,
    stdout=None,
) -> list[dict]:
    ordered = _ordered_courses(courses)
    if not ordered:
        return []
    stdin = sys.stdin if stdin is None else stdin
    stdout = sys.stderr if stdout is None else stdout

    if read_key is not None:
        return _run_course_picker(ordered, read_key, stdout)
    with _picker_terminal_session(stdin, stdout):
        return _select_ordered_courses(ordered, stdin, stdout)


def batch_fetch_course_assignments(page, course_ids: list[int | str]) -> list[dict]:
    if not course_ids:
        return []
    return page.evaluate(
        """async ({ courseIds, baseUrl }) => {
            const sleep = (ms) => new Promise((resolve) => setTimeout(resolve, ms));

            const fetchCourse = async (courseId) => {
                let url = `${baseUrl}/api/v1/courses/${courseId}/assignments?order_by=due_at&include[]=submission&per_page=100`;
                const items = [];
                while (url) {
                    let attempt = 0;
                    let success = false;
                    while (attempt < 3 && !success) {
                        attempt++;
                        const controller = new AbortController();
                        const timeout = setTimeout(() => controller.abort(), 15000);
                        try {
                            const response = await fetch(url, {
                                method: "GET",
                                credentials: "include",
                                headers: {"Accept": "application/json"},
                                signal: controller.signal
                            });

                            const isRateLimit = response.status === 429 || (
                                response.status === 403 && (await response.clone().text()).toLowerCase().includes("rate limit")
                            );

                            if (isRateLimit && attempt < 3) {
                                const retryAfter = parseInt(response.headers.get("Retry-After") || "0", 10);
                                const delay = retryAfter > 0 ? retryAfter * 1000 : (attempt * 800 + Math.random() * 300);
                                await sleep(delay);
                                continue;
                            }

                            if (!response.ok) {
                                return {
                                    courseId,
                                    ok: false,
                                    status: response.status,
                                    error: (await response.text()).slice(0, 500),
                                    items: []
                                };
                            }
                            const data = await response.json();
                            if (Array.isArray(data)) {
                                items.push(...data);
                            }
                            const linkHeader = response.headers.get("Link") || "";
                            const nextMatch = linkHeader.match(/<([^>]+)>;\\s*rel="next"/);
                            url = nextMatch ? nextMatch[1] : null;
                            success = true;
                        } catch (e) {
                            if (attempt < 3 && e.name === "AbortError") {
                                await sleep(attempt * 500);
                                continue;
                            }
                            return {
                                courseId,
                                ok: false,
                                status: 0,
                                error: e.name === "AbortError" ? "Canvas API request timed out" : String(e),
                                items: []
                            };
                        } finally {
                            clearTimeout(timeout);
                        }
                    }
                }
                return { courseId, ok: true, status: 200, items };
            };

            const concurrency = 6;
            const results = new Array(courseIds.length);
            let index = 0;
            const workers = Array.from({ length: Math.min(concurrency, courseIds.length) }, async () => {
                while (index < courseIds.length) {
                    const i = index++;
                    results[i] = await fetchCourse(courseIds[i]);
                }
            });
            await Promise.all(workers);
            return results;
        }""",
        {"courseIds": course_ids, "baseUrl": BASE_URL},
    )


def _course_for_id(courses: list[dict], course_id: int) -> dict:
    for course in courses:
        if str(course.get("id")) == str(course_id):
            return course
    return {}


def _resource_row(
    resource: dict,
    *,
    resource_type: str,
    course_id: int,
    courses: list[dict],
    tz: ZoneInfo,
    url_fallback: str = "",
) -> dict:
    course = _course_for_id(courses, course_id)
    course_name = (
        course.get("course_code")
        or course.get("name")
        or f"Course {course_id}"
    )
    is_page = resource_type == "pages"
    due = parse_canvas_datetime(resource.get("due_at")) if not is_page else None
    description = resource.get("body") if is_page else resource.get("description")
    if resource_type == "assignments":
        title = resource.get("name")
        untitled = "(Untitled assignment)"
    elif resource_type == "quizzes":
        title = resource.get("title")
        untitled = "(Untitled quiz)"
    else:
        title = resource.get("title") or resource.get("name")
        untitled = "(Untitled page)"
    return {
        "course": course_name,
        "course_name": course.get("name") or course_name,
        "title": title or untitled,
        "due_at": due.isoformat() if due else None,
        "due_display": (
            due.astimezone(tz).strftime("%a, %b %d, %Y at %I:%M %p %Z")
            if due
            else "No due date"
        ),
        "instructions": html_to_text(description) or (
            "(No page content provided)"
            if is_page
            else "(No instructions provided)"
        ),
        "attachments": extract_attachments(description),
        "url": resource.get("html_url") or url_fallback,
        "submission_status": (
            submission_status(resource)
            if resource_type == "assignments"
            else None
        ),
    }


def _page_target_url(course_id: int, page_url: str | None = None) -> str:
    base = f"{BASE_URL}/courses/{course_id}/pages"
    return f"{base}/{quote(page_url, safe='')}" if page_url else base


def _page_row(
    resource: dict,
    *,
    course_id: int,
    courses: list[dict],
    tz: ZoneInfo,
    page_url: str | None = None,
    url_fallback: str = "",
) -> dict:
    resource_page_url = resource.get("url")
    if not isinstance(resource_page_url, str) or not resource_page_url:
        resource_page_url = page_url
    page_fallback = (
        _page_target_url(course_id, resource_page_url)
        if resource_page_url
        else url_fallback
    )
    row = _resource_row(
        resource,
        resource_type="pages",
        course_id=course_id,
        courses=courses,
        tz=tz,
        url_fallback=page_fallback,
    )
    row["resource_type"] = "page"
    row["page_id"] = resource.get("page_id", resource.get("id"))
    row["page_url"] = resource_page_url
    row["published"] = resource.get("published")
    row["front_page"] = resource.get("front_page")
    row["updated_at"] = resource.get("updated_at")
    row["url"] = urljoin(BASE_URL + "/", row["url"])
    return row


def _file_row(
    resource: dict,
    *,
    course_id: int,
    courses: list[dict],
) -> dict:
    try:
        file_id = int(resource.get("id"))
    except (TypeError, ValueError) as exc:
        raise RuntimeError("Canvas returned a file without a valid ID") from exc

    raw_name = resource.get("display_name") or resource.get("filename")
    if not isinstance(raw_name, str):
        raw_name = str(raw_name or "")
    name = _normalize_attachment_label(raw_name) or f"file-{file_id}"
    resolved = _canvas_file_download_url(resource.get("url"))
    download_url = (
        resolved[1]
        if resolved is not None and resolved[0] == file_id
        else f"{BASE_URL}/courses/{course_id}/files/{file_id}/download"
    )
    course = _course_for_id(courses, course_id)
    course_name = (
        course.get("course_code")
        or course.get("name")
        or f"Course {course_id}"
    )
    return {
        "resource_type": "file",
        "course": course_name,
        "course_name": course.get("name") or course_name,
        "course_id": course_id,
        "id": file_id,
        "title": name,
        "name": name,
        "filename": resource.get("filename") or name,
        "content_type": (
            resource.get("content-type")
            or resource.get("content_type")
        ),
        "size": resource.get("size"),
        "updated_at": (
            resource.get("updated_at")
            or resource.get("modified_at")
        ),
        "locked": (
            resource.get("locked_for_user")
            if "locked_for_user" in resource
            else resource.get("locked")
        ),
        "hidden": resource.get("hidden"),
        "folder_id": resource.get("folder_id"),
        "url": download_url,
        "preview_url": resource.get("preview_url"),
    }


def _fetch_page_target(
    page,
    course_id: int,
    page_url: str | None,
    target_url: str,
    tz: ZoneInfo,
    courses: list[dict] | None,
) -> list[dict]:
    if page_url is None:
        resources = paginated_get(
            page,
            f"/api/v1/courses/{course_id}/pages",
            [
                ("sort", "title"),
                ("order", "asc"),
                ("include[]", "body"),
            ],
        )
    else:
        encoded_page_url = quote(page_url, safe="")
        resource = api_get(
            page,
            f"/api/v1/courses/{course_id}/pages/{encoded_page_url}",
            None,
        )
        resources = [resource]

    if not isinstance(resources, list):
        raise RuntimeError("Canvas returned an invalid page response")
    if any(not isinstance(resource, dict) for resource in resources):
        raise RuntimeError("Canvas returned an invalid page resource")

    courses = fetch_courses(page) if courses is None else courses
    return [
        _page_row(
            resource,
            course_id=course_id,
            courses=courses,
            tz=tz,
            page_url=page_url,
            url_fallback=target_url,
        )
        for resource in resources
    ]


def _fetch_file_target(
    page,
    course_id: int,
    file_id: int | None,
    courses: list[dict] | None,
) -> list[dict]:
    if file_id is None:
        resources = paginated_get(
            page,
            f"/api/v1/courses/{course_id}/files",
            [("sort", "name"), ("order", "asc")],
        )
    else:
        resource = api_get(
            page,
            f"/api/v1/courses/{course_id}/files/{file_id}",
            None,
        )
        resources = [resource]

    if not isinstance(resources, list):
        raise RuntimeError("Canvas returned an invalid file response")
    if any(not isinstance(resource, dict) for resource in resources):
        raise RuntimeError("Canvas returned an invalid file resource")

    courses = fetch_courses(page) if courses is None else courses
    return [
        _file_row(resource, course_id=course_id, courses=courses)
        for resource in resources
    ]
def _canvas_navigation_guard(route, request) -> None:
    try:
        is_navigation = request.is_navigation_request()
    except Exception:
        is_navigation = getattr(request, "resource_type", "") == "document"
    if not is_navigation:
        route.continue_()
        return

    try:
        parsed = urlsplit(str(request.url))
    except Exception:
        route.abort()
        return
    if (
        parsed.scheme != "https"
        or (parsed.hostname or "").casefold() != CANVAS_HOST.casefold()
    ):
        route.abort()
        return
    route.continue_()


def _validate_final_course_url(
    course_id: int,
    final_url: str,
) -> str:
    try:
        validated_url = validate_canvas_course_url(final_url)
    except ValueError as exc:
        raise RuntimeError(
            "Canvas course section navigation left ufl.instructure.com."
        ) from exc
    match = _COURSE_PATH_RE.match(urlsplit(validated_url).path)
    if match is None or int(match.group("course_id")) != course_id:
        raise RuntimeError(
            "Canvas course section navigation left the requested course."
        )
    return validated_url


def _web_target_content(page) -> tuple[str, str]:
    for selector in ("main", "body"):
        try:
            locator = page.locator(selector)
            if locator.count() == 0:
                continue
            text = str(locator.inner_text(timeout=60_000) or "").strip()
            markup = str(locator.inner_html(timeout=60_000) or "")
            return text, markup
        except Exception:
            continue
    try:
        return "", str(page.content() or "")
    except Exception:
        return "", ""


def fetch_canvas_web_target(
    page,
    target_url: str,
    courses: list[dict] | None = None,
) -> list[dict]:
    validated_url = validate_canvas_course_url(target_url)
    parsed = urlsplit(validated_url)
    match = _COURSE_PATH_RE.match(parsed.path)
    if match is None:
        raise RuntimeError("Canvas URL does not identify a course")
    course_id = int(match.group("course_id"))

    page.route("**/*", _canvas_navigation_guard)
    try:
        response = page.goto(
            validated_url,
            wait_until="domcontentloaded",
            timeout=60_000,
        )
        if response is None:
            raise RuntimeError(
                f"Canvas course section returned no response: {validated_url}"
            )
        if not getattr(response, "ok", False):
            raise RuntimeError(
                "Canvas course section request failed "
                f"({getattr(response, 'status', 0)}): {validated_url}"
            )
        effective_url = _validate_final_course_url(
            course_id,
            str(getattr(page, "url", "") or ""),
        )
        text, markup = _web_target_content(page)
        try:
            title = str(page.title() or "").strip()
        except Exception:
            title = ""
        if not title:
            title = next(
                (line.strip() for line in text.splitlines() if line.strip()),
                "Canvas course section",
            )
    finally:
        page.unroute("**/*", _canvas_navigation_guard)
    courses = fetch_courses(page) if courses is None else courses
    course = _course_for_id(courses, course_id)
    course_display = course_label(course) if course else f"Course {course_id}"
    return [
        {
            "resource_type": "course_section",
            "course": course_display,
            "course_name": course.get("name") or course_display,
            "course_id": course_id,
            "title": title,
            "due_at": None,
            "due_display": "No due date",
            "instructions": text or "(No page content provided)",
            "attachments": extract_attachments(markup),
            "url": effective_url,
            "submission_status": None,
        }
    ]


def fetch_canvas_target(
    page,
    target_url: str,
    tz: ZoneInfo = ZoneInfo("America/New_York"),
    courses: list[dict] | None = None,
) -> list[dict]:
    try:
        resource_type, course_id, resource_id = parse_canvas_resource_url(target_url)
    except ValueError:
        validate_canvas_course_url(target_url)
        return fetch_canvas_web_target(page, target_url, courses=courses)
    if resource_type == "pages":
        return _fetch_page_target(
            page,
            course_id,
            resource_id if isinstance(resource_id, str) else None,
            target_url,
            tz,
            courses,
        )
    if resource_type == "files":
        return _fetch_file_target(
            page,
            course_id,
            resource_id if isinstance(resource_id, int) else None,
            courses,
        )
    if resource_type not in {"assignments", "quizzes"}:
        raise RuntimeError(f"Unsupported Canvas resource type: {resource_type}")

    params = (
        [("include[]", "submission")]
        if resource_type == "assignments"
        else None
    )
    resource = api_get(
        page,
        f"/api/v1/courses/{course_id}/{resource_type}/{resource_id}",
        params,
    )
    if not isinstance(resource, dict):
        raise RuntimeError(
            f"Unexpected Canvas response for {resource_type} {resource_id}"
        )
    courses = fetch_courses(page) if courses is None else courses
    return [
        _resource_row(
            resource,
            resource_type=resource_type,
            course_id=course_id,
            courses=courses,
            tz=tz,
            url_fallback=target_url,
        )
    ]


class SubmissionCancelled(RuntimeError):
    pass


def _validated_submission_files(
    file_paths: list[str],
    allowed_extensions,
) -> list[Path]:
    if not file_paths:
        raise ValueError("at least one --file is required")

    allowed = {
        str(extension).casefold().lstrip(".")
        for extension in (allowed_extensions or [])
    }
    validated = []
    for value in file_paths:
        path = Path(value).expanduser()
        if not path.is_file():
            raise ValueError(f"submission file is not a readable file: {path}")
        if allowed:
            extension = path.suffix.lstrip(".").casefold()
            if extension not in allowed:
                values = ", ".join(sorted(allowed))
                raise ValueError(
                    f"{path.name} is not an allowed file type; "
                    f"Canvas allows: {values}"
                )
        validated.append(path)
    return validated


def prepare_file_submission(
    page,
    target_url: str,
    file_paths: list[str],
    *,
    courses: list[dict] | None = None,
    tz: ZoneInfo = ZoneInfo("America/New_York"),
) -> dict:
    resource_type, course_id, assignment_id = parse_canvas_target_url(target_url)
    if resource_type != "assignments":
        raise ValueError(
            "file submissions require an assignment URL; "
            "quiz URLs must be opened in Canvas"
        )

    assignment = api_get(
        page,
        f"/api/v1/courses/{course_id}/assignments/{assignment_id}",
        [("include[]", "submission")],
    )
    if not isinstance(assignment, dict):
        raise RuntimeError("Canvas returned an invalid assignment response")
    if assignment.get("published") is False:
        raise RuntimeError("Canvas assignment is unpublished")
    if assignment.get("locked_for_user"):
        raise RuntimeError("Canvas assignment is locked for this user")

    submission_types = {
        str(value).casefold()
        for value in (assignment.get("submission_types") or [])
    }
    if "online_upload" not in submission_types:
        raise RuntimeError(
            "Canvas assignment does not accept file uploads "
            f"(submission types: {', '.join(sorted(submission_types)) or 'none'})"
        )

    files = _validated_submission_files(
        file_paths,
        assignment.get("allowed_extensions"),
    )
    courses = fetch_courses(page) if courses is None else courses
    return {
        "course_id": course_id,
        "assignment_id": assignment_id,
        "files": files,
        "assignment": _resource_row(
            assignment,
            resource_type="assignments",
            course_id=course_id,
            courses=courses,
            tz=tz,
            url_fallback=target_url,
        ),
    }


def _canvas_upload_completion_url(upload_url: str, location: str | None) -> str:
    if not location:
        raise RuntimeError("Canvas upload did not provide a completion URL")
    completion_url = urljoin(upload_url, location)
    parsed = urlsplit(completion_url)
    if (
        parsed.scheme != "https"
        or (parsed.hostname or "").casefold() != CANVAS_HOST.casefold()
        or not parsed.path.startswith("/api/")
    ):
        raise RuntimeError("Canvas upload returned an unsafe completion URL")
    return completion_url


def _upload_submission_file(
    page,
    course_id: int,
    assignment_id: int,
    path: Path,
) -> dict:
    content_type = (
        mimetypes.guess_type(path.name)[0]
        or "application/octet-stream"
    )
    initial_form = FormData()
    initial_form.append("name", path.name)
    initial_form.append("size", str(path.stat().st_size))
    initial_form.append("content_type", content_type)
    initial = api_post(
        page,
        f"/api/v1/courses/{course_id}/assignments/"
        f"{assignment_id}/submissions/self/files",
        multipart=initial_form,
    )
    if not isinstance(initial, dict):
        raise RuntimeError("Canvas returned an invalid upload token response")

    upload_url = initial.get("upload_url")
    upload_params = initial.get("upload_params")
    if not isinstance(upload_url, str) or not upload_url:
        raise RuntimeError("Canvas did not return an upload URL")
    if urlsplit(upload_url).scheme != "https":
        raise RuntimeError("Canvas returned an unsafe upload URL")
    if not isinstance(upload_params, dict):
        raise RuntimeError("Canvas did not return upload parameters")

    upload_form = FormData()
    for key, value in upload_params.items():
        if value is None:
            value = ""
        if not isinstance(value, (str, int, float, bool)):
            raise RuntimeError("Canvas returned unsupported upload parameters")
        upload_form.append(str(key), value)
    upload_form.append(
        "file",
        {
            "name": path.name,
            "mimeType": content_type,
            "buffer": path.read_bytes(),
        },
    )

    request = _request_client(page)
    response = request.post(
        upload_url,
        headers={"Accept": "application/json"},
        multipart=upload_form,
        timeout=60_000,
        max_redirects=0,
    )
    location = (getattr(response, "headers", {}) or {}).get("location")
    if response.status == 201 or 300 <= response.status < 400:
        response = request.get(
            _canvas_upload_completion_url(upload_url, location),
            headers={"Accept": "application/json"},
            timeout=60_000,
        )
    result = _response_json(response, upload_url)
    if not isinstance(result, dict):
        raise RuntimeError("Canvas returned an invalid uploaded-file response")
    return result


def confirm_file_submission(plan: dict) -> None:
    if not sys.stdin.isatty() or not sys.stderr.isatty():
        raise RuntimeError(
            "refusing to submit without an interactive terminal; "
            "use --dry-run to preview the submission"
        )

    assignment = plan["assignment"]
    print(
        f"About to submit {len(plan['files'])} file(s) to "
        f"{assignment['title']!r} in {assignment['course']!r}.",
        file=sys.stderr,
    )
    for path in plan["files"]:
        print(f"  File: {path}", file=sys.stderr)
    print(
        "This will create or replace your Canvas submission. "
        "Type SUBMIT to continue:",
        file=sys.stderr,
        flush=True,
    )
    answer = sys.stdin.readline().strip()
    if answer != "SUBMIT":
        raise SubmissionCancelled("Submission cancelled; Canvas was not changed.")


def dry_run_file_submission(plan: dict) -> dict:
    return {
        "submitted": False,
        "dry_run": True,
        "assignment": plan["assignment"],
        "files": [
            {"name": path.name, "path": str(path)}
            for path in plan["files"]
        ],
    }


def submit_file_assignment(page, plan: dict, progress=None) -> dict:
    uploaded = []
    for path in plan["files"]:
        if progress is not None:
            progress.message(f"Uploading {path.name}...")
        uploaded_file = _upload_submission_file(
            page,
            plan["course_id"],
            plan["assignment_id"],
            path,
        )
        file_id = uploaded_file.get("id")
        if file_id is None:
            raise RuntimeError(
                f"Canvas did not return a file ID for {path.name}"
            )
        uploaded.append(
            {
                "name": path.name,
                "path": str(path),
                "file_id": file_id,
            }
        )

    submission_form = FormData()
    submission_form.append("submission[submission_type]", "online_upload")
    for uploaded_file in uploaded:
        submission_form.append(
            "submission[file_ids][]",
            str(uploaded_file["file_id"]),
        )
    submission = api_post(
        page,
        f"/api/v1/courses/{plan['course_id']}/assignments/"
        f"{plan['assignment_id']}/submissions",
        multipart=submission_form,
    )
    return {
        "submitted": True,
        "dry_run": False,
        "assignment": plan["assignment"],
        "files": uploaded,
        "submission": submission,
    }


def print_submission_human(result: dict) -> None:
    assignment = result["assignment"]
    print(f"Assignment: {assignment['title']}")
    print(f"Course: {assignment['course']}")
    for file_info in result["files"]:
        print(f"File: {file_info['path']}")
    if result.get("dry_run"):
        print("Dry run only; Canvas was not changed.")
    else:
        print("Canvas submission completed.")


def fetch_assignments(
    page,
    days: int | str = 14,
    tz: ZoneInfo = ZoneInfo("America/New_York"),
    courses: list[dict] | None = None,
    status_filter: str = "unsubmitted",
    progress=None,
):
    courses = fetch_courses(page) if courses is None else courses
    status_filter = normalize_status_filter(status_filter)
    days = normalize_days(days)

    now = datetime.now(timezone.utc)
    cutoff = None if days == 0 else now + timedelta(days=days)
    rows = []

    valid_courses = [c for c in courses if c.get("id")]
    course_ids = [c["id"] for c in valid_courses]
    batch_results = batch_fetch_course_assignments(page, course_ids)
    batch_map = {r.get("courseId"): r for r in batch_results if isinstance(r, dict)}

    for course in valid_courses:
        course_id = course["id"]
        course_name = (
            course.get("course_code")
            or course.get("name")
            or f"Course {course_id}"
        )
        res = batch_map.get(course_id)
        if not res or not res.get("ok"):
            err_msg = res.get("error") if res else "No response returned"
            _auth_message(f"Warning: skipped {course_name}: {err_msg}", progress)
            continue

        assignments = res.get("items") or []
        for assignment in assignments:
            if assignment.get("published") is False:
                continue

            due = parse_canvas_datetime(assignment.get("due_at"))

            if due is None and cutoff is not None:
                continue
            if due is not None:
                # Ignore assignments whose deadlines have already passed.
                if due < now:
                    continue
                if cutoff is not None and due > cutoff:
                    continue

            status = submission_status(assignment)
            if not status_matches(status, status_filter):
                continue
            rows.append(
                _resource_row(
                    assignment,
                    resource_type="assignments",
                    course_id=course_id,
                    courses=courses,
                    tz=tz,
                )
            )

    # Due-dated assignments first, then assignments without due dates.
    rows.sort(
        key=lambda item: (
            item["due_at"] is None,
            item["due_at"] or "9999-12-31T23:59:59+00:00",
            item["course"].lower(),
            item["title"].lower(),
        )
    )
    return rows


def shorten_rows(rows: list[dict]) -> list[dict]:
    return [
        {
            key: value
            for key, value in row.items()
            if key not in {"instructions", "submission_status"}
        }
        for row in rows
    ]


def print_human(rows, *, shorten: bool = False):
    if not rows:
        print("No upcoming assignments found.")
        return

    for index, item in enumerate(rows, 1):
        if item.get("resource_type") == "file":
            print(f"{index}. {item['name']}")
            print(f"   Course: {item['course']}")
            if item.get("content_type"):
                print(f"   Type: {item['content_type']}")
            if item.get("size") is not None:
                print(f"   Size: {item['size']} bytes")
            if item.get("updated_at"):
                print(f"   Updated: {item['updated_at']}")
            if item.get("url"):
                print(f"   URL: {item['url']}")
            if item.get("local_path"):
                print(f"   Downloaded to: {item['local_path']}")
            print()
            continue
        print(f"{index}. {item['title']}")
        print(f"   Course: {item['course']}")
        print(f"   Due: {item['due_display']}")
        if not shorten and item.get("submission_status") is not None:
            print(f"   Status: {item['submission_status']}")
        if item["url"]:
            print(f"   URL: {item['url']}")
        if not shorten:
            print("   Instructions:")
            for line in item["instructions"].splitlines() or [""]:
                print(f"     {line}")
        attachments = item.get("attachments") or []
        if attachments:
            print("   Attachments:")
            for attachment in attachments:
                detail = f"{attachment['name']}: {attachment['url']}"
                if attachment.get("local_path"):
                    detail += f" (downloaded to {attachment['local_path']})"
                print(f"     {detail}")
        print()


def main():
    parser = argparse.ArgumentParser(
        usage="%(prog)s [COMMAND] [ARGUMENT] [OPTIONS]",
        description=(
            "Read UF Canvas assignments, quizzes, pages, files, and "
            "course navigation."
        ),
        formatter_class=argparse.RawDescriptionHelpFormatter,
        epilog=(
            "Commands:\n"
            "  (no command)                       Fetch upcoming assignments.\n"
            "  auth setup                         Configure Canvas credentials.\n"
            "  student on|off|status              Manage student-only course mode.\n"
            "  course COURSE_ID                   List clickable course sections.\n"
            "  fetch CANVAS_URL [--download-dir DIRECTORY]\n"
            "                                     Fetch an assignment, quiz, page, or files.\n"
            "  submit ASSIGNMENT_URL --file PATH  Submit one or more assignment files.\n"
        ),
    )
    parser.add_argument(
        "command",
        nargs="?",
        help=argparse.SUPPRESS,
    )
    parser.add_argument(
        "action",
        nargs="?",
        help=argparse.SUPPRESS,
    )
    parser.add_argument(
        "--json",
        action="store_true",
        help="Output machine-readable JSON (useful for agents).",
    )
    parser.add_argument(
        "--shorten",
        action="store_true",
        help="Omit instructions and submission status from assignment output.",
    )
    parser.add_argument(
        "--download-dir",
        metavar="DIRECTORY",
        help="Download Canvas files linked in instructions to DIRECTORY.",
    )
    parser.add_argument(
        "--file",
        dest="submission_files",
        action="append",
        metavar="PATH",
        help="File to submit; repeat for multiple files with canvas submit.",
    )
    parser.add_argument(
        "--dry-run",
        action="store_true",
        help="Show a file submission plan without uploading or submitting it.",
    )
    parser.add_argument(
        "--days",
        default="14",
        help="Only show assignments due within N days, or 'all' for all future assignments and assignments without due dates. Default: 14.",
    )
    parser.add_argument(
        "--timezone",
        default="America/New_York",
        help="Timezone used for displaying deadlines. Default: America/New_York.",
    )
    parser.add_argument(
        "--course",
        dest="courses",
        action="append",
        nargs="?",
        const="",
        metavar="NAME",
        help="Filter by course code or name; omit NAME for interactive multi-select.",
    )
    parser.add_argument(
        "--list-courses",
        action="store_true",
        help="List active courses instead of assignments.",
    )
    parser.add_argument(
        "--status",
        choices=STATUS_FILTERS,
        default="unsubmitted",
        help="Assignment status to include: unsubmitted (default), submitted, graded, or all.",
    )
    args = parser.parse_args()
    course_navigation_mode = False
    course_id = None
    target_resource_type = None

    if args.command == "auth":
        if args.action != "setup":
            parser.error(
                "supported commands: canvas auth setup; "
                "canvas student on|off|status; "
                "canvas course COURSE_ID; "
                "canvas fetch CANVAS_URL; "
                "canvas submit ASSIGNMENT_URL --file PATH"
            )
        try:
            return configure_auth()
        except KeyboardInterrupt:
            print("\nCancelled.", file=sys.stderr)
            return 130
        except Exception as exc:
            print(f"Error: {exc}", file=sys.stderr)
            return 1

    if args.command == "student":
        if args.action not in STUDENT_MODE_COMMANDS:
            parser.error(
                "supported commands: canvas auth setup; "
                "canvas student on|off|status; "
                "canvas course COURSE_ID; "
                "canvas fetch CANVAS_URL; "
                "canvas submit ASSIGNMENT_URL --file PATH"
            )
        try:
            return student_mode_command(args.action)
        except KeyboardInterrupt:
            print("\nCancelled.", file=sys.stderr)
            return 130
        except Exception as exc:
            print(f"Error: {exc}", file=sys.stderr)
            return 1

    if args.command == "course":
        if not args.action:
            parser.error("usage: canvas course COURSE_ID")
        if args.download_dir:
            parser.error("--download-dir cannot be combined with canvas course")
        if args.submission_files or args.dry_run:
            parser.error("--file and --dry-run require canvas submit")
        if args.courses:
            parser.error("--course cannot be combined with canvas course")
        if args.list_courses:
            parser.error("--list-courses cannot be combined with canvas course")
        if args.days != "14":
            parser.error("--days cannot be combined with canvas course")
        if args.status != "unsubmitted":
            parser.error("--status cannot be combined with canvas course")
        try:
            course_id = parse_course_id(args.action)
        except ValueError as exc:
            parser.error(str(exc))
        target_url = None
        target_fetch = False
        submission_mode = False
        course_navigation_mode = True
    elif args.command == "submit":
        if not args.action:
            parser.error("usage: canvas submit ASSIGNMENT_URL --file PATH")
        if not args.submission_files:
            parser.error("canvas submit requires at least one --file PATH")
        if args.download_dir:
            parser.error("--download-dir cannot be combined with canvas submit")
        if args.courses:
            parser.error("--course cannot be combined with canvas submit")
        if args.list_courses:
            parser.error("--list-courses cannot be combined with canvas submit")
        if args.days != "14":
            parser.error("--days cannot be combined with canvas submit")
        if args.status != "unsubmitted":
            parser.error("--status cannot be combined with canvas submit")
        try:
            resource_type, _, _ = parse_canvas_target_url(args.action)
        except ValueError as exc:
            parser.error(str(exc))
        if resource_type != "assignments":
            parser.error(
                "file submissions require an assignment URL; "
                "quiz URLs must be opened in Canvas"
            )
        target_url = args.action
        target_fetch = False
        submission_mode = True
    elif args.command == "fetch":
        if not args.action:
            parser.error("usage: canvas fetch CANVAS_URL")
        if args.submission_files or args.dry_run:
            parser.error("--file and --dry-run require canvas submit")
        if args.courses:
            parser.error("--course cannot be combined with canvas fetch")
        if args.list_courses:
            parser.error("--list-courses cannot be combined with canvas fetch")
        if args.days != "14":
            parser.error("--days cannot be combined with canvas fetch")
        if args.status != "unsubmitted":
            parser.error("--status cannot be combined with canvas fetch")
        try:
            validate_canvas_course_url(args.action)
            try:
                target_resource_type, _, _ = parse_canvas_resource_url(
                    args.action
                )
            except ValueError:
                target_resource_type = None
        except ValueError as exc:
            parser.error(str(exc))
        target_url = args.action
        target_fetch = True
        submission_mode = False
    elif args.command is not None or args.action is not None:
        parser.error(
            "supported commands: canvas auth setup; "
            "canvas student on|off|status; "
            "canvas course COURSE_ID; "
            "canvas fetch CANVAS_URL; "
            "canvas submit ASSIGNMENT_URL --file PATH"
        )
    else:
        if args.submission_files or args.dry_run:
            parser.error("--file and --dry-run require canvas submit")
        target_url = None
        target_fetch = False
        submission_mode = False
    try:
        student_only = load_student_mode() == STUDENT_MODE_ON
    except Exception as exc:
        print(f"Error: {exc}", file=sys.stderr)
        return 1
    try:
        days = normalize_days(args.days)
    except ValueError as exc:
        parser.error(str(exc))

    interactive_course = any(value == "" for value in (args.courses or []))
    if interactive_course and len(args.courses or []) != 1:
        parser.error("--course without a name cannot be combined with another --course")
    if interactive_course:
        course_filters = set()
    else:
        try:
            course_filters = normalize_course_filters(args.courses)
        except ValueError as exc:
            parser.error(str(exc))

    try:
        tz = ZoneInfo(args.timezone)
    except Exception:
        parser.error(f"Unknown timezone: {args.timezone}")

    PROFILE_DIR.mkdir(parents=True, exist_ok=True)

    try:
        with sync_playwright() as p:
            context = launch_context(p)
            try:
                page = context.pages[0] if context.pages else context.new_page()
                with _loading_bar(
                    sys.stderr,
                    "Authenticating with UF",
                    "Canvas authentication ready.",
                ) as auth_progress:
                    ensure_login(page, progress=auth_progress)
                with _loading_bar(
                    sys.stderr,
                    "Loading Canvas courses",
                    "Canvas courses loaded.",
                ):
                    available_courses = fetch_courses(page, student_only=student_only)
                terminal_session = (
                    _picker_terminal_session(sys.stdin, sys.stderr)
                    if interactive_course
                    else contextlib.nullcontext()
                )
                with terminal_session:
                    if submission_mode or target_fetch or course_navigation_mode:
                        courses = available_courses
                    elif interactive_course:
                        courses = _select_ordered_courses(
                            _ordered_courses(available_courses),
                            sys.stdin,
                            sys.stderr,
                        )
                    else:
                        courses = filter_courses(available_courses, course_filters)

                    if args.list_courses:
                        course_rows = [
                            course_summary(course)
                            for course in sorted(
                                courses,
                                key=lambda item: course_label(item).casefold(),
                            )
                        ]
                    elif course_navigation_mode:
                        with _loading_bar(
                            sys.stderr,
                            "Loading course sections",
                            "Course sections loaded.",
                        ):
                            navigation = fetch_course_navigation(
                                page,
                                course_id,
                                courses=available_courses,
                            )
                    elif submission_mode:
                        with _loading_bar(
                            sys.stderr,
                            "Preparing Canvas submission",
                            "Canvas submission ready.",
                        ):
                            plan = prepare_file_submission(
                                page,
                                target_url,
                                args.submission_files,
                                courses=available_courses,
                                tz=tz,
                            )
                        if args.dry_run:
                            submission_result = dry_run_file_submission(plan)
                        else:
                            confirm_file_submission(plan)
                            with _loading_bar(
                                sys.stderr,
                                "Submitting Canvas files",
                                "Canvas files submitted.",
                            ) as submission_progress:
                                submission_result = submit_file_assignment(
                                    page,
                                    plan,
                                    progress=submission_progress,
                                )
                    elif target_fetch:
                        with _loading_bar(
                            sys.stderr,
                            "Loading Canvas resource",
                            "Canvas resource loaded.",
                        ):
                            rows = fetch_canvas_target(
                                page,
                                target_url,
                                tz,
                                courses=available_courses,
                            )
                    else:
                        with _loading_bar(
                            sys.stderr,
                            "Loading Canvas assignments",
                            "Canvas assignments loaded.",
                        ) as assignments_progress:
                            rows = fetch_assignments(
                                page,
                                days,
                                tz,
                                courses=courses,
                                status_filter=args.status,
                                progress=assignments_progress,
                            )

                    if args.download_dir and not args.list_courses:
                        with _loading_bar(
                            sys.stderr,
                            "Downloading Canvas attachments",
                            "Canvas attachments downloaded.",
                        ) as download_progress:
                            if target_fetch and target_resource_type == "files":
                                download_files(
                                    page,
                                    rows,
                                    args.download_dir,
                                    progress=download_progress,
                                )
                            else:
                                download_attachments(
                                    page,
                                    rows,
                                    args.download_dir,
                                    progress=download_progress,
                                )
                    if interactive_course:
                        _flush_terminal_input(sys.stdin)
            finally:
                context.close()

    except SubmissionCancelled as exc:
        print(str(exc), file=sys.stderr)
        return 1
    except KeyboardInterrupt:
        print("\nCancelled.", file=sys.stderr)
        return 130
    except Exception as exc:
        print(f"Error: {exc}", file=sys.stderr)
        return 1


    if args.list_courses:
        if args.json:
            print(json.dumps(course_rows, indent=2, ensure_ascii=False))
        else:
            print_courses(courses)
    elif course_navigation_mode:
        if args.json:
            print(json.dumps(navigation, indent=2, ensure_ascii=False))
        else:
            print_course_navigation(navigation)
    elif submission_mode:
        output_result = submission_result
        if args.shorten:
            output_result = {
                **submission_result,
                "assignment": shorten_rows(
                    [submission_result["assignment"]]
                )[0],
            }
        if args.json:
            print(json.dumps(output_result, indent=2, ensure_ascii=False))
        else:
            print_submission_human(output_result)
    elif args.json:
        output_rows = shorten_rows(rows) if args.shorten else rows
        print(json.dumps(output_rows, indent=2, ensure_ascii=False))
    else:
        print_human(rows, shorten=args.shorten)

    return 0


if __name__ == "__main__":
    raise SystemExit(main())
